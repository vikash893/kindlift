{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "jest --verbose --forceExit",
    "test:coverage": "jest --verbose --coverage --forceExit"
