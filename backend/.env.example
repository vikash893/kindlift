# ─── Database ───────────────────────────────────────
# MongoDB Atlas connection string
# Sign up: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kindlift?retryWrites=true&w=majority

# ─── Authentication ─────────────────────────────────
# Secret key for JWT token signing (use a strong random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_key_here

# ─── Email (Gmail SMTP) ─────────────────────────────
# Gmail address for sending OTP verification emails
EMAIL_USER=your_email@gmail.com

# Gmail App Password (NOT your regular password)
# Steps: Google Account → Security → 2-Step Verification → App Passwords → Generate
EMAIL_PASS=abcd_efgh_ijkl_mnop





# ─── Frontend ───────────────────────────────────────
# URL of the React frontend (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# ─── ML Service ─────────────────────────────────────
# URL of the Python ML sentiment prediction service
# Local:  http://localhost:5001
# Deploy: https://kindlift-ml.onrender.com  (or your deployed ML service URL)
ML_SERVICE_URL=http://localhost:5001

# ─── Server ─────────────────────────────────────────
# Port for the Express server (default: 8000)
PORT=8000
